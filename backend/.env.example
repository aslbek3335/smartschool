# Server
PORT=5000
NODE_ENV=production

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartschool
DB_USER=postgres
DB_PASSWORD=your_password_here

# Neon.tech yoki boshqa cloud DB
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_this
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL — CORS allowlist uchun (vergul bilan ajratilgan, kerak emas bo'lsa bitta URL)
# Production:
FRONTEND_URL=https://maktabtizimi.uz
# Render.com backend'ingiz URL'i (frontend .env uchun):
# VITE_API_URL=https://your-app-name.onrender.com/api
